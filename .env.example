# Labi, the AI lab assistant. These keys are only read by the functions in api/
# (never by the browser bundle). Copy this file to .env for local development
# and set the same variables in the Vercel project settings.

# Cloudflare dashboard → Workers AI → "Use REST API" (token needs Workers AI: Read)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# ElevenLabs → Developers → API keys (needs Text to Speech and Speech to Text)
ELEVENLABS_API_KEY=

# ── Optional ──────────────────────────────────────────────────────────
# Labi's voice.
# ELEVENLABS_VOICE_ID=cgSgspJ2msm6clMCkdW9
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# ELEVENLABS_STT_MODEL=scribe_v2_realtime
# CF_CHAT_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# Another OpenAI-compatible endpoint for the chat model, e.g. an AI Gateway.
# Defaults to the Workers AI endpoint of CLOUDFLARE_ACCOUNT_ID.
# CLOUDFLARE_AI_BASE_URL=
# Identical chat requests raced per reply (the first to stream wins). 1 = off.
# CF_CHAT_HEDGE=2

# Replies per day over all visitors.
# LABI_DAILY_TURNS=3000
# Shared store for the rate limiter. Without it each server instance counts on
# its own, so set these on Vercel (Upstash Redis has a free tier).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
