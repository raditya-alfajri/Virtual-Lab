# Labi, the AI lab assistant. These keys are only read by the functions in api/
# (never by the browser bundle). Copy this file to .env for local development
# and set the same variables in the Vercel project settings.

# Google AI Studio → Get API key
GEMINI_API_KEY=
# The Gemini model Labi talks with, as listed in Google AI Studio.
GEMINI_MODEL=
# ElevenLabs → Developers → API keys (needs Text to Speech and Speech to Text)
ELEVENLABS_API_KEY=

# ── Optional ──────────────────────────────────────────────────────────
# How much the model thinks before it answers. Little thinking keeps spoken
# replies quick; not sent when empty. Use `low` if the model refuses `minimal`.
# GEMINI_REASONING_EFFORT=minimal
# Gemini's OpenAI-compatible endpoint.
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Labi's voice.
# ELEVENLABS_VOICE_ID=cgSgspJ2msm6clMCkdW9
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# ELEVENLABS_STT_MODEL=scribe_v2_realtime

# Replies per day and per minute over all visitors. Keep them under the Gemini
# project's own limits (see Rate limit in Google AI Studio).
# LABI_DAILY_TURNS=400
# LABI_GLOBAL_RPM=15
# Shared store for the rate limiter. Without it each server instance counts on
# its own, so set these on Vercel (Upstash Redis has a free tier).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
